---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import config from '../../content/config/config.json';
import { getCollection } from 'astro:content';

const publications = (await getCollection('publication')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Publications | ${config.seo.title}`}
			description="Publications, papers, and research output."
		/>
		<style>
			main {
				width: 960px;
			}

			section {
				padding: 1rem 0 2rem;
			}

			h1 {
				margin-bottom: 2rem;
			}

			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}

			li {
				padding: 1.5rem;
				border: 1px solid rgba(var(--gray-light), 0.8);
				border-radius: 16px;
				background: white;
				box-shadow: var(--box-shadow);
			}

			li * {
				transition: 0.2s ease;
			}

			li a {
				text-decoration: none;
			}

			.title {
				margin: 0 0 0.5rem;
				color: rgb(var(--black));
				line-height: 1.2;
			}

			.meta,
			.date,
			.type {
				margin: 0;
				color: rgb(var(--gray));
			}

			.meta,
			.type {
				margin-bottom: 0.5rem;
			}

			.abstract {
				margin: 1rem 0 0;
				color: rgb(var(--gray-dark));
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: 1rem;
			}

			.links a {
				color: rgb(var(--accent));
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}

			li:hover .title,
			li:hover .date,
			li:hover .meta,
			li:hover .type {
				color: rgb(var(--accent));
			}

			@media (max-width: 720px) {
				main {
					width: auto;
				}

				li {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Publications</h1>

				<ul>
					{
						publications.map((publication) => (
							<li>
								<a href={`/publications/${publication.id}/`}>
									<h2 class="title">{publication.data.title}</h2>
									<p class="meta">{publication.data.authors.join(', ')}</p>

									{publication.data.venue && (
										<p class="meta">{publication.data.venue}</p>
									)}

									<p class="date">
										<FormattedDate date={publication.data.pubDate} />
									</p>

									{publication.data.publicationType && (
										<p class="type">{publication.data.publicationType}</p>
									)}

									{publication.data.abstract && (
										<p class="abstract">{publication.data.abstract}</p>
									)}
								</a>

								{(publication.data.pdfUrl || publication.data.externalUrl) && (
									<div class="links">
										{publication.data.pdfUrl && (
											<a
												href={publication.data.pdfUrl}
												target="_blank"
												rel="noreferrer"
											>
												View PDF
											</a>
										)}
										{publication.data.externalUrl && (
											<a
												href={publication.data.externalUrl}
												target="_blank"
												rel="noreferrer"
											>
												External Link
											</a>
										)}
									</div>
								)}
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>